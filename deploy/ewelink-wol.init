#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1

start_service() {
    [ -s /etc/ewelink-wol/client-app.json ] || return 0
    [ -s /etc/ewelink-wol/auth.json ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/ewelink-wol
    procd_set_param env GOGC=50 GOMEMLIMIT=32MiB
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0"
    procd_close_instance
}

reload_service() {
    stop
    start
}
